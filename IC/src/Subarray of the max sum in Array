package ARRAY;
import java.util.*;
public class ARRAYofSum {
	public static void main(String[]args) {
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int [] arr=new int[n];
		for(int i=0;i<n;i++) {
			arr[i]=s.nextInt();
		}
		int si=0,ei=0;
		int max=arr[0];
		for(int i=0;i<arr.length;i++) {
			for(int j=i;j<arr.length;j++) {
				int sum=0;
				for(int k=i;k<=j;k++) {
					sum +=arr[k];	
				}
				if(max<sum) {
					si=i;
					ei=j;
					max=sum;
				}
	}
}
		System.out.println(max);
		for (int i=si;i<=ei;i++) {
			System.out.print(arr[i]+" ");
		}
	}
}
