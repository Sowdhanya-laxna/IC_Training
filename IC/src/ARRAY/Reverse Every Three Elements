package ARRAY;
import java.util.*;
public class ReverseEveryThreeElements {

	public static void main(String[] args) {
		 Scanner s = new Scanner(System.in);
	        System.out.print("Enter the size: ");
	        int n = s.nextInt();

	        int[] arr = new int[n];

	        System.out.println("Enter the elements:");
	        for (int i = 0; i < n; i++) {
	            arr[i] = s.nextInt();
	        }

	        int k = 3;
	        for (int i = 0; i < n; i += k) {
	            int left = i;
	            int right = Math.min(i + k - 1, n - 1);
	            while (left < right) {
	                int temp = arr[left];
	                arr[left] = arr[right];
	                arr[right] = temp;

	                left++;
	                right--;
	            }
	        }
	        System.out.print("Array after reversing every 3 elements: ");
	        for (int i = 0; i < n; i++) {
	            System.out.print(arr[i] + " ");
	        }

	}

}
