package ARRAY;
import java.util.*;
public class Revinpair {

	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
        System.out.print("Enter the size: ");
        int n = s.nextInt();

        int[] arr = new int[n];

        System.out.println("Enter the elements:");
        for (int i = 0; i < n; i++) {
            arr[i] = s.nextInt();
        }
        for (int i = 0; i < n - 1; i += 2) {
            int temp = arr[i];
            arr[i] = arr[i + 1];
            arr[i + 1] = temp;
        }

        System.out.print("Array after reversing pairs: ");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}

	


