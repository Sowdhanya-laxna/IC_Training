package ARRAY;
import java.util.*;
public class FETCHINGSUBARRYUSINGINDEX {
	public static void main(String[]args) {
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int [] arr=new int[n];
		for(int i=0;i<n;i++) {
			arr[i]=s.nextInt();
		}
		System.out.print("Enter the start index:");
		int si=s.nextInt();
		System.out.print("Enter the end index:");
		int ei=s.nextInt();
		
		int [] carr=new int[ei-si+1];
		int index=0;
		for(int i=si;i<=ei;i++) {
			carr[index++]=arr[i];
		}
		System.out.println(Arrays.toString(carr));
	}
}
