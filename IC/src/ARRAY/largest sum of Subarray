package ARRAY;
import java.util.*;
public class Sumofarray {
	public static void main(String[]args) {
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int [] arr=new int[n];
		for(int i=0;i<n;i++) {
			arr[i]=s.nextInt();
		}
		int max=arr[0];
		for(int i=0;i<arr.length;i++) {
			for(int j=i;j<arr.length;j++) {
				int sum=0;
				for(int k=i;k<=j;k++) {
					sum +=arr[k];
				
				}
				if(max<sum)
					max=sum;
	}
}
		System.out.println(max);
	}
}
